{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* Build Info / Paths */
    "baseUrl": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    /* Bundler / Module / Node */
    "allowImportingTsExtensions": true,
    "module": "NodeNext",
    "moduleDetection": "force",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,

    /* JS Runtime / Language Target */
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2023"
    ],
    "target": "ESNext",
    "useDefineForClassFields": true,

    /* JSX / React */
    "jsx": "react-jsx",

    /* Linting / Strictness */
    "declaration": true,
    "erasableSyntaxOnly": false,
    "emitDeclarationOnly": true,
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strict": true,

    /* NOTA (nov/2026): tipagem forte. Além do "strict", as opções do
       @tsconfig/strictest, e o isolatedDeclarations: todo export precisa de
       tipo explícito (retorno de função, constante, parâmetro). O resto
       (variáveis locais, callbacks, desestruturação) o ESLint cobra
       (typedef e explicit-function-return-type, no eslint.config.js). */
    "isolatedDeclarations": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noImplicitThis": true,
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src"
  ]
}
